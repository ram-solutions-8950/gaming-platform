# ============================================================
# Gaming platform - backend environment
#
# Copy to .env and fill in. docker-compose passes this file to
# the backend via env_file, and the values are baked in when the
# container is CREATED -- so after editing this file you must
# recreate the container, not just restart it:
#
#     docker compose up -d backend        # picks up .env
#     docker compose restart backend      # does NOT
#
# The deploy workflow runs `docker compose up -d --build`, so a
# normal deploy does pick up .env changes.
# ============================================================

# ---- Core ----
# "production" on the live server. Note that this makes the
# create_super_admin CLI refuse to run, by design.
ENVIRONMENT=development

DATABASE_URL=postgresql://user:password@db:5432/gaming_db
REDIS_URL=redis://redis:6379/0

# Where the backend redirects players back to after a hosted
# gateway checkout. Must be the real site on production.
FRONTEND_URL=https://polandexim.com

CORS_ORIGINS=["https://polandexim.com","https://admin.polandexim.com"]

# Generate fresh values; never reuse the defaults in config.py.
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# Apply pending Alembic migrations on startup.
AUTO_MIGRATE=true

LOG_LEVEL=INFO


# ============================================================
# PAYMENT GATEWAYS
#
# Credentials are NOT set here. Every gateway's key, secret,
# sandbox flag and payout token is entered by an admin in
#
#     Admin Panel > Payment Gateways
#
# and stored in the payment_gateway_configs table. That way a key
# can be rotated without a redeploy, and a stale variable left in
# this file can never quietly override, or stand in for, what an
# admin set.
#
# Deposits and payouts are selected independently there, so one
# gateway can collect deposits while a different one settles
# withdrawals:
#   - deposits  -> the gateway marked Active
#   - payouts   -> the gateway with Payouts enabled
#
# Only the non-secret deployment addresses below belong in .env.
# ============================================================

# Fallback deposit gateway, used only until an admin marks one
# Active in the panel: easebuzz | cashfree | razorpay
PAYMENT_PROVIDER=easebuzz

# Easebuzz return URLs. Register BOTH of these as the Success and
# Failure URLs in the Easebuzz dashboard. Easebuzz sends the
# player's browser here with a signed form POST; the endpoint
# verifies it, credits the wallet, then redirects to
# FRONTEND_URL/wallet. The panel can override these per gateway.
EASEBUZZ_SURL=https://polandexim.com/api/v1/payments/easebuzz/return
EASEBUZZ_FURL=https://polandexim.com/api/v1/payments/easebuzz/return

# Cashfree return/notify URLs, if Cashfree is used for deposits.
CASHFREE_RETURN_URL=https://polandexim.com/wallet?status={order_status}&order_id={order_id}
CASHFREE_NOTIFY_URL=https://polandexim.com/api/v1/payments/webhook?provider=cashfree
