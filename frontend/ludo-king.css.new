/* =========================================================
   LUDO KING — clean responsive game layout
   Board is always a complete square. Dice sits below board.
   ========================================================= */

.ludo-felt {
  --lk-red: #e53935;
  --lk-green: #43a047;
  --lk-yellow: #fdd835;
  --lk-blue: #1e88e5;
  background:
    radial-gradient(ellipse at 50% 12%, rgba(255, 215, 64, 0.08), transparent 42%),
    radial-gradient(circle at 18% 78%, rgba(67, 160, 71, 0.12), transparent 36%),
    linear-gradient(180deg, #0d2818 0%, #07140d 100%);
}

.ludo-game-page {
  width: 100%;
  min-height: 100dvh;
  overflow-x: hidden;
}

.ludo-game-container {
  width: min(100%, 1240px);
  margin-inline: auto;
  padding: 12px 16px 24px;
}

.ludo-game-header {
  min-height: 58px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 12px;
}

.ludo-logo {
  display: flex;
  gap: 1px;
  margin: 0;
  font-size: clamp(28px, 4vw, 42px);
  font-weight: 950;
  line-height: 1;
  letter-spacing: -0.06em;
  text-shadow: 0 3px 0 rgba(0, 0, 0, 0.35);
}

.ludo-header-stats {
  display: flex;
  align-items: center;
  gap: 8px;
}

.ludo-stat-card,
.ludo-live-pill {
  border: 1px solid rgba(255, 255, 255, 0.10);
  background: rgba(0, 0, 0, 0.30);
  border-radius: 13px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,.04);
}

.ludo-stat-card {
  min-width: 72px;
  padding: 7px 12px;
  text-align: center;
}

.ludo-stat-card span {
  display: block;
  color: rgba(255,255,255,.48);
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .08em;
}

.ludo-stat-card strong {
  display: block;
  margin-top: 1px;
  font-size: 16px;
  line-height: 1;
}

.ludo-stat-card .entry { color: #69f0ae; }
.ludo-stat-card .prize { color: #fdd835; }

.ludo-live-pill {
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 9px 12px;
  color: #69f0ae;
  font-size: 12px;
  font-weight: 900;
}

.ludo-live-pill i {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #34d399;
  box-shadow: 0 0 10px rgba(52,211,153,.8);
  animation: ludoLivePulse 1.4s ease-in-out infinite;
}

@keyframes ludoLivePulse {
  50% { opacity: .45; transform: scale(.78); }
}

.ludo-game-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 360px;
  align-items: start;
  gap: 22px;
}

.ludo-board-column {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ludo-board-stage {
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: visible;
}

/* This is the critical sizing rule: never use a fixed landscape height. */
.ludo-board-stage .ludo-board-wrap {
  width: min(100%, 620px) !important;
  max-width: 620px !important;
  height: auto !important;
  aspect-ratio: 1 / 1 !important;
  flex: 0 0 auto;
  margin: 0 auto;
}

.ludo-board-wrap {
  --lk-red: #e53935;
  --lk-green: #43a047;
  --lk-yellow: #fdd835;
  --lk-blue: #1e88e5;
  position: relative;
}

.ludo-board-frame {
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #8d6e63 0%, #5d4037 45%, #3e2723 100%);
  box-shadow:
    0 18px 50px rgba(0,0,0,.55),
    inset 0 1px 0 rgba(255,255,255,.25);
}

/* The dice component is intentionally below the board, never beside it. */
.ludo-dice-below-board {
  width: min(100%, 620px);
  margin-top: 10px;
}

.ludo-dice-below-board > * {
  width: 100%;
}

/* Keep the existing token/dice animations. */
.ludo-yard-pulse { animation: ludoYardPulse 1.4s ease-in-out infinite; }

@keyframes ludoYardPulse {
  0%,100% { box-shadow: 0 0 0 0 rgba(255,255,255,.15), 0 8px 18px rgba(0,0,0,.25); }
  50% { box-shadow: 0 0 0 8px rgba(255,215,64,.35), 0 8px 18px rgba(0,0,0,.25); }
}

.ludo-token-wrap {
  transition: left .48s cubic-bezier(.22,1,.36,1), top .48s cubic-bezier(.22,1,.36,1);
}

.ludo-token-hop .ludo-token-body { animation: ludoTokenHop .48s ease-out; }
@keyframes ludoTokenHop {
  0% { transform: translateY(0) scale(1); }
  40% { transform: translateY(-55%) scale(1.18); }
  100% { transform: translateY(0) scale(1); }
}

.ludo-token-selectable .ludo-token-body { animation: ludoTokenBounce .9s ease-in-out infinite; }
@keyframes ludoTokenBounce {
  0%,100% { transform: translateY(0) scale(1.08); }
  50% { transform: translateY(-18%) scale(1.16); }
}

.ludo-dice-scene { perspective: 520px; }
.ludo-dice-cube {
  position: relative;
  width: 72px;
  height: 72px;
  transform-style: preserve-3d;
  transition: transform .7s cubic-bezier(.2,.8,.2,1);
}
.ludo-dice-cube.rolling { animation: ludoDiceTumble .9s linear infinite; }
@keyframes ludoDiceTumble {
  0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg) scale(1.08); }
  25% { transform: rotateX(240deg) rotateY(160deg) rotateZ(40deg) scale(1.18); }
  50% { transform: rotateX(420deg) rotateY(340deg) rotateZ(90deg) scale(1.05); }
  75% { transform: rotateX(600deg) rotateY(500deg) rotateZ(20deg) scale(1.2); }
  100% { transform: rotateX(780deg) rotateY(720deg) rotateZ(0deg) scale(1.08); }
}

.ludo-dice-face {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(3,1fr);
  grid-template-rows: repeat(3,1fr);
  padding: 10px;
  background: linear-gradient(145deg,#fff,#e8e8e8);
  border-radius: 12px;
  border: 2px solid #f5f5f5;
  box-shadow: inset 0 0 8px rgba(0,0,0,.08);
  backface-visibility: hidden;
}
.ludo-dice-face .pip {
  width: 12px;
  height: 12px;
  margin: auto;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%,#ef5350,#b71c1c);
  box-shadow: 0 1px 2px rgba(0,0,0,.35);
}
.ludo-dice-face.f1 { transform: rotateY(0deg) translateZ(36px); }
.ludo-dice-face.f2 { transform: rotateY(90deg) translateZ(36px); }
.ludo-dice-face.f3 { transform: rotateX(90deg) translateZ(36px); }
.ludo-dice-face.f4 { transform: rotateX(-90deg) translateZ(36px); }
.ludo-dice-face.f5 { transform: rotateY(-90deg) translateZ(36px); }
.ludo-dice-face.f6 { transform: rotateY(180deg) translateZ(36px); }
.ludo-dice-show-1 { transform: rotateX(0deg) rotateY(0deg); }
.ludo-dice-show-2 { transform: rotateY(-90deg); }
.ludo-dice-show-3 { transform: rotateX(-90deg); }
.ludo-dice-show-4 { transform: rotateX(90deg); }
.ludo-dice-show-5 { transform: rotateY(90deg); }
.ludo-dice-show-6 { transform: rotateY(180deg); }

.ludo-six-burst { animation: ludoSixPop .7s ease-out; }
@keyframes ludoSixPop {
  0% { transform: scale(.4); opacity: 0; }
  40% { transform: scale(1.2); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
.ludo-sparkle {
  position: absolute;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ffe082;
  animation: ludoSpark .9s ease-out forwards;
}
@keyframes ludoSpark {
  0% { transform: translate(0,0) scale(1); opacity: 1; }
  100% { transform: translate(var(--sx),var(--sy)) scale(0); opacity: 0; }
}
.ludo-roll-btn { animation: ludoRollGlow 1.2s ease-in-out infinite; }
@keyframes ludoRollGlow {
  0%,100% { box-shadow: 0 6px 0 #1b5e20, 0 0 0 0 rgba(253,216,53,.4); }
  50% { box-shadow: 0 6px 0 #1b5e20, 0 0 18px 6px rgba(253,216,53,.45); }
}

/* Make the existing player panel visually match the reference. */
.ludo-side-column {
  min-width: 0;
}

.ludo-side-column .space-y-4 {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.ludo-side-column .space-y-4 > * { margin-top: 0 !important; }

.ludo-side-column .rounded-xl,
.ludo-side-column .rounded-2xl {
  border-color: rgba(255, 193, 7, .34) !important;
  background: linear-gradient(180deg, rgba(24,31,34,.88), rgba(12,20,24,.88)) !important;
  box-shadow: 0 12px 30px rgba(0,0,0,.25), inset 0 1px 0 rgba(255,255,255,.04);
}

/* Tablet / phone landscape: preserve the whole board using the viewport width. */
@media (max-width: 900px) {
  .ludo-game-container { padding: 8px 10px 18px; }
  .ludo-game-layout { grid-template-columns: minmax(0, 1fr) 300px; gap: 12px; }
  .ludo-board-stage .ludo-board-wrap { width: min(100%, 560px) !important; max-width: 560px !important; }
  .ludo-dice-below-board { max-width: 560px; }
}

@media (max-width: 700px) and (orientation: landscape) {
  .ludo-game-page { min-height: 100dvh; }
  .ludo-game-container { padding: 5px 7px 12px; }
  .ludo-game-header { min-height: 34px; margin-bottom: 5px; }
  .ludo-logo { font-size: 21px; }
  .ludo-stat-card { min-width: 52px; padding: 4px 7px; border-radius: 8px; }
  .ludo-stat-card span { font-size: 7px; }
  .ludo-stat-card strong { font-size: 12px; }
  .ludo-live-pill { padding: 5px 7px; font-size: 9px; border-radius: 8px; }
  .ludo-live-pill i { width: 6px; height: 6px; }
  .ludo-game-layout { grid-template-columns: minmax(0, 1fr) 220px; gap: 7px; }
  .ludo-board-stage .ludo-board-wrap { width: min(100%, calc(100dvh - 105px)) !important; max-width: calc(100dvh - 105px) !important; }
  .ludo-dice-below-board { width: min(100%, calc(100dvh - 105px)); margin-top: 6px; }
  .ludo-side-column .space-y-4 { gap: 6px; }
  .ludo-side-column .rounded-xl { border-radius: 9px !important; }
  .ludo-side-column .p-4 { padding: 7px !important; }
  .ludo-side-column .p-3 { padding: 6px !important; }
  .ludo-side-column .text-xl { font-size: 15px !important; }
  .ludo-side-column .text-2xl { font-size: 18px !important; }
}

@media (max-width: 640px) and (orientation: portrait) {
  .ludo-game-container { padding: 8px 8px 20px; }
  .ludo-game-header { min-height: 44px; }
  .ludo-logo { font-size: 28px; }
  .ludo-header-stats { gap: 4px; }
  .ludo-stat-card { min-width: 56px; padding: 5px 7px; }
  .ludo-stat-card strong { font-size: 13px; }
  .ludo-live-pill { padding: 7px 8px; }
  .ludo-game-layout { grid-template-columns: 1fr; gap: 12px; }
  .ludo-board-stage .ludo-board-wrap {
    width: min(94vw, 560px) !important;
    max-width: 560px !important;
  }
  .ludo-dice-below-board { width: min(94vw, 560px); }
  .ludo-side-column { width: 100%; }
}

@media (max-width: 390px) {
  .ludo-game-container { padding-inline: 5px; }
  .ludo-header-stats .ludo-stat-card:first-child { display: none; }
  .ludo-logo { font-size: 25px; }
  .ludo-board-stage .ludo-board-wrap { width: 96vw !important; }
  .ludo-dice-below-board { width: 96vw; }
}
