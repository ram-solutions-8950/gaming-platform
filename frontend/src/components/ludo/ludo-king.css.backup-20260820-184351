   FINAL LANDSCAPE LUDO FIX
   ========================================================= */

@media (orientation: landscape) and (min-width: 700px) {

  .ludo-game-page {
    width: 100%;
    height: 100dvh;
    min-height: 0;
    overflow: hidden;
    padding: 0 8px 58px 8px;
    box-sizing: border-box;
  }

  .ludo-game-container {
    width: 100%;
    height: calc(100dvh - 58px);
    max-width: 1200px;
    margin: 0 auto;

    display: flex;
    flex-direction: column;

    overflow: hidden;
  }

  /* HEADER */

  .ludo-game-header {
    flex: 0 0 42px;
