  position: relative !important;

  width: min(100%, 620px) !important;
  height: auto !important;

  aspect-ratio: 1 / 1 !important;

  min-width: 0 !important;
  min-height: 0 !important;

  flex: 0 0 auto !important;

  margin-left: auto !important;
  margin-right: auto !important;
}

/* The frame must follow the square wrapper */
.ludo-board-column .ludo-board-frame {
  width: 100% !important;
  height: 100% !important;

  aspect-ratio: 1 / 1 !important;

  min-width: 0 !important;
  min-height: 0 !important;
}

/* Actual 15 × 15 Ludo grid */
.ludo-board-column .ludo-board-frame > div {
  width: 100%;
  height: 100%;
  aspect-ratio: 1 / 1;
}

/* Prevent grid from being stretched */
.ludo-board-column .ludo-board-wrap *,
.ludo-board-column .ludo-board-frame {
  box-sizing: border-box;
}

/* Landscape/tablet */
@media (min-width: 768px) and (orientation: landscape) {
  .ludo-board-column .ludo-board-wrap {
    width: min(62vh, 620px) !important;
    height: min(62vh, 620px) !important;
    aspect-ratio: 1 / 1 !important;
  }
}

/* Desktop landscape */
@media (min-width: 1024px) and (orientation: landscape) {
  .ludo-board-column .ludo-board-wrap {
    width: min(70vh, 620px) !important;
    height: min(70vh, 620px) !important;
    aspect-ratio: 1 / 1 !important;
  }
}

/* Phone portrait */
@media (max-width: 767px) and (orientation: portrait) {
  .ludo-board-column .ludo-board-wrap {
    width: min(92vw, 620px) !important;
    height: auto !important;
    aspect-ratio: 1 / 1 !important;
  }
}