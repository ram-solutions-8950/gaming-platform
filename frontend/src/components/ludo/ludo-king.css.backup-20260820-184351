.ludo-felt {
  background:
    radial-gradient(ellipse at 50% 20%, rgba(255, 215, 64, 0.12), transparent 50%),
    radial-gradient(circle at 20% 80%, rgba(67, 160, 71, 0.18), transparent 40%),
    linear-gradient(180deg, #0d2818 0%, #07140d 100%);
}

.ludo-board-wrap {
  --lk-red: #e53935;
  --lk-green: #43a047;
  --lk-yellow: #fdd835;
  --lk-blue: #1e88e5;
}

.ludo-board-frame {
  background:
    linear-gradient(145deg, #8d6e63 0%, #5d4037 40%, #3e2723 100%);
  box-shadow:
    0 18px 50px rgba(0, 0, 0, 0.55),
    inset 0 1px 0 rgba(255, 255, 255, 0.25);
}

.ludo-yard-pulse {
  animation: ludoYardPulse 1.4s ease-in-out infinite;
}

@keyframes ludoYardPulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.15), 0 8px 18px rgba(0, 0, 0, 0.25); }
  50% { box-shadow: 0 0 0 8px rgba(255, 215, 64, 0.35), 0 8px 18px rgba(0, 0, 0, 0.25); }
}

.ludo-token-wrap {
  transition: left 0.48s cubic-bezier(0.22, 1, 0.36, 1), top 0.48s cubic-bezier(0.22, 1, 0.36, 1);
}

.ludo-token-hop .ludo-token-body {
  animation: ludoTokenHop 0.48s ease-out;
}

@keyframes ludoTokenHop {
  0% { transform: translateY(0) scale(1); }
  40% { transform: translateY(-55%) scale(1.18); }
  100% { transform: translateY(0) scale(1); }
}

.ludo-token-selectable .ludo-token-body {
  animation: ludoTokenBounce 0.9s ease-in-out infinite;
}

@keyframes ludoTokenBounce {
  0%, 100% { transform: translateY(0) scale(1.08); }
  50% { transform: translateY(-18%) scale(1.16); }
}

.ludo-dice-scene {
  perspective: 520px;
}

.ludo-dice-cube {
  position: relative;
  width: 72px;
  height: 72px;
  transform-style: preserve-3d;
  transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.ludo-dice-cube.rolling {
  animation: ludoDiceTumble 0.9s linear infinite;
}

@keyframes ludoDiceTumble {
  0% { transform: rotateX(0deg) rotateY(0deg) rotateZ(0deg) scale(1.08); }
  25% { transform: rotateX(240deg) rotateY(160deg) rotateZ(40deg) scale(1.18); }
  50% { transform: rotateX(420deg) rotateY(340deg) rotateZ(90deg) scale(1.05); }
  75% { transform: rotateX(600deg) rotateY(500deg) rotateZ(20deg) scale(1.2); }
  100% { transform: rotateX(780deg) rotateY(720deg) rotateZ(0deg) scale(1.08); }
}

.ludo-dice-face {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  grid-template-rows: repeat(3, 1fr);
  padding: 10px;
  background: linear-gradient(145deg, #ffffff, #e8e8e8);
  border-radius: 12px;
  border: 2px solid #f5f5f5;
  box-shadow: inset 0 0 8px rgba(0, 0, 0, 0.08);
  backface-visibility: hidden;
}

.ludo-dice-face .pip {
  width: 12px;
  height: 12px;
  margin: auto;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #ef5350, #b71c1c);
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
}

.ludo-dice-face.f1 { transform: rotateY(0deg) translateZ(36px); }
.ludo-dice-face.f2 { transform: rotateY(90deg) translateZ(36px); }
.ludo-dice-face.f3 { transform: rotateX(90deg) translateZ(36px); }
.ludo-dice-face.f4 { transform: rotateX(-90deg) translateZ(36px); }
.ludo-dice-face.f5 { transform: rotateY(-90deg) translateZ(36px); }
.ludo-dice-face.f6 { transform: rotateY(180deg) translateZ(36px); }

.ludo-dice-show-1 { transform: rotateX(0deg) rotateY(0deg); }
.ludo-dice-show-2 { transform: rotateY(-90deg); }
.ludo-dice-show-3 { transform: rotateX(-90deg); }
.ludo-dice-show-4 { transform: rotateX(90deg); }
.ludo-dice-show-5 { transform: rotateY(90deg); }
.ludo-dice-show-6 { transform: rotateY(180deg); }

.ludo-six-burst {
  animation: ludoSixPop 0.7s ease-out;
}

@keyframes ludoSixPop {
  0% { transform: scale(0.4); opacity: 0; }
  40% { transform: scale(1.2); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.ludo-sparkle {
  position: absolute;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ffe082;
  animation: ludoSpark 0.9s ease-out forwards;
}

@keyframes ludoSpark {
  0% { transform: translate(0, 0) scale(1); opacity: 1; }
  100% { transform: translate(var(--sx), var(--sy)) scale(0); opacity: 0; }
}

.ludo-roll-btn {
  animation: ludoRollGlow 1.2s ease-in-out infinite;
}

@keyframes ludoRollGlow {
  0%, 100% { box-shadow: 0 6px 0 #1b5e20, 0 0 0 0 rgba(253, 216, 53, 0.4); }
  50% { box-shadow: 0 6px 0 #1b5e20, 0 0 18px 6px rgba(253, 216, 53, 0.45); }
}

.ludo-center-tri {
  position: absolute;
  width: 50%;
  height: 50%;
}

@media (max-width: 640px) {
  .ludo-dice-cube,
  .ludo-dice-face.f1,
  .ludo-dice-face.f2,
  .ludo-dice-face.f3,
  .ludo-dice-face.f4,
  .ludo-dice-face.f5,
  .ludo-dice-face.f6 {
    /* keep cube size via width/height; Z is half of 64 */
  }
}
/* =========================================================
   RESPONSIVE LUDO BOARD
   ========================================================= */

.ludo-board-wrap {
  width: min(92vw, 620px) !important;
  aspect-ratio: 1 / 1;
  margin-left: auto;
  margin-right: auto;
}

/* Mobile portrait */
@media (max-width: 640px) and (orientation: portrait) {
  .ludo-board-wrap {
    /*
     * Reserve space for:
     * header + turn indicator + dice + bottom navigation
     */
    width: min(92vw, calc(100dvh - 300px)) !important;
    max-width: calc(100dvh - 300px) !important;
  }
}

/* Mobile / tablet landscape */
@media (max-width: 1199px) and (orientation: landscape) {
  .ludo-board-wrap {
    /*
     * Height is the limiting dimension in landscape.
     */
    width: min(62dvh, 620px) !important;
    max-width: min(62dvh, 620px) !important;
  }
}

/* Small landscape phones */
@media (max-width: 700px) and (orientation: landscape) {
  .ludo-board-wrap {
    width: min(58dvh, 520px) !important;
    max-width: min(58dvh, 520px) !important;
  }
}
