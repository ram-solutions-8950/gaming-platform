# AquaSan Environment Variables Example
# Duplicate this file to .env.local and populate with your Cashfree credentials

# Cashfree App ID and Secret Key from Cashfree Merchant Dashboard
CASHFREE_APP_ID=your_cashfree_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_secret_key_here

# Cashfree Environment Mode ('sandbox' for testing, 'production' for live)
NEXT_PUBLIC_CASHFREE_MODE=sandbox
